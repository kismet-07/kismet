{
  "name": "ran-rebirth",
  "version": "0.1.0",
  "private": true,
  "description": "RAN: Rebirth - Browser-based 2D MMORPG",
  "repository": {
    "type": "git",
    "url": "https://github.com/kismet-07/kismet.git"
  },
  "workspaces": [
    "apps/client",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=@ran-rebirth/client",
    "dev:server": "npm run dev --workspace=@ran-rebirth/server",
    "build": "tsc -b",
    "build:shared": "npm run build --workspace=@ran-rebirth/shared",
    "build:client": "npm run build --workspace=@ran-rebirth/client",
    "build:server": "npm run build --workspace=@ran-rebirth/server"
  },
  "keywords": [
    "ran-rebirth",
    "mmorpg",
    "phaser",
    "typescript"
  ],
  "license": "UNLICENSED",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
